<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Emeklilik Anı Sayfası</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0b0e14;
            --card-bg: rgba(22, 27, 34, 0.85);
            --border-color: rgba(212, 175, 55, 0.35);
            --accent-gold: #d4af37;
            --accent-gold-light: #f3e5ab;
            --text-primary: #f0f6fc;
            --text-secondary: #9ea7b3;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            background-image: 
                radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.18), transparent 75%),
                radial-gradient(circle at 80% 80%, rgba(212, 175, 55, 0.08), transparent 50%);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            padding: 20px 15px 60px 15px;
            display: flex;
            justify-content: center;
        }

        .container {
            max-width: 720px;
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .sticky-nav {
            position: fixed;
            top: 15px;
            right: 15px;
            z-index: 99999;
            display: flex;
            gap: 10px;
            background: rgba(11, 14, 20, 0.9);
            padding: 8px 12px;
            border-radius: 30px;
            border: 1px solid var(--accent-gold);
            backdrop-filter: blur(10px);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.6);
        }

        .nav-btn {
            background: rgba(212, 175, 55, 0.15);
            border: 1px solid var(--border-color);
            color: var(--accent-gold-light);
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
        }

        .nav-btn:hover {
            background: var(--accent-gold);
            color: #000;
            transform: scale(1.1);
        }

        .nav-btn::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: -32px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.9);
            color: var(--accent-gold-light);
            font-size: 0.75rem;
            padding: 4px 8px;
            border-radius: 4px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
            border: 1px solid var(--border-color);
        }

        .nav-btn:hover::after {
            opacity: 1;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-radius: 18px;
            padding: 25px 20px;
            text-align: center;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
            position: relative;
        }
        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(212, 175, 55, 0.3);
            padding-bottom: 12px;
            margin-bottom: 20px;
        }

        .company-badge {
            font-family: 'Cinzel', serif;
            font-size: 0.9rem;
            letter-spacing: 2px;
            color: var(--accent-gold);
            text-transform: uppercase;
            font-weight: 700;
        }

        .current-date-badge {
            font-size: 0.75rem;
            color: var(--accent-gold-light);
            background: rgba(212, 175, 55, 0.1);
            border: 1px solid var(--border-color);
            padding: 4px 10px;
            border-radius: 20px;
        }

        h1 {
            font-family: 'Cinzel', serif;
            font-size: 1.9rem;
            color: #ffffff;
            margin-bottom: 4px;
            font-weight: 700;
        }

        .subtitle {
            font-size: 1rem;
            color: var(--accent-gold-light);
            margin-bottom: 10px;
        }

        .retirement-date-box {
            display: inline-block;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(212, 175, 55, 0.2);
            padding: 6px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 20px;
        }

        .retirement-date-box strong {
            color: var(--accent-gold);
        }

        .hero-banner {
            width: 100%;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            position: relative;
            box-shadow: 0 8px 25px rgba(0,0,0,0.5);
            cursor: pointer;
        }

        .hero-banner img {
            width: 100%;
            height: auto;
            max-height: 420px;
            object-fit: cover;
            display: block;
            transition: transform 0.3s ease;
        }

        .hero-banner:hover img {
            transform: scale(1.02);
        }

        .hero-caption {
            background: rgba(11, 14, 20, 0.85);
            color: var(--accent-gold-light);
            font-size: 0.85rem;
            padding: 8px 12px;
            text-align: center;
            font-style: italic;
            border-top: 1px solid rgba(212, 175, 55, 0.2);
        }

        .media-container {
            width: 100%;
            border-radius: 12px;
            overflow: hidden;
            background: #000;
            border: 1px solid var(--border-color);
        }

        video {
            width: 100%;
            display: block;
            max-height: 380px;
            object-fit: cover;
        }

        .section-title {
            font-family: 'Cinzel', serif;
            color: var(--accent-gold);
            margin-bottom: 18px;
            font-size: 1.2rem;
            letter-spacing: 1px;
        }

        .photo-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 12px;
        }

        .photo-card {
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(0, 0, 0, 0.3);
            cursor: pointer;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .photo-card:hover {
            transform: translateY(-3px);
            border-color: var(--accent-gold);
        }

        .photo-card img {
            width: 100%;
            height: 130px;
            object-fit: cover;
            display: block;
        }

        .photo-card .photo-desc {
            font-size: 0.75rem;
            color: var(--text-secondary);
            padding: 6px;
            text-align: center;
        }
        .message-text {
            font-size: 0.95rem;
            line-height: 1.8;
            color: #e6edf3;
            font-style: italic;
            text-align: justify;
            text-align-last: center;
        }

        .retirement-counter {
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.18) 0%, rgba(22, 27, 34, 0.9) 100%);
            border: 1px solid var(--accent-gold);
        }

        .counter-number {
            font-family: 'Cinzel', serif;
            font-size: 2.8rem;
            font-weight: 700;
            color: var(--accent-gold);
            margin: 8px 0;
            text-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
        }

        .contributors-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 10px;
            margin-top: 15px;
        }

        .contributor-item {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(212, 175, 55, 0.2);
            border-radius: 8px;
            padding: 8px 6px;
            font-size: 0.82rem;
            color: #e6edf3;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .contributor-item::before {
            content: "•";
            color: var(--accent-gold);
            font-weight: bold;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 999999;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .modal-overlay.active {
            display: flex !important;
        }

        .modal-content {
            background: #161b22;
            border: 1px solid var(--accent-gold);
            border-radius: 16px;
            max-width: 550px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
            padding: 25px;
            position: relative;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
            text-align: center;
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 18px;
            font-size: 1.8rem;
            color: var(--accent-gold-light);
            cursor: pointer;
            line-height: 1;
        }

        .modal-close:hover {
            color: var(--accent-gold);
        }

        .timeline-list {
            list-style: none;
            text-align: left;
            margin-top: 15px;
        }

        .timeline-item {
            position: relative;
            padding-left: 20px;
            margin-bottom: 18px;
            border-left: 2px solid var(--accent-gold);
        }

        .timeline-item::before {
            content: "";
            position: absolute;
            left: -6px;
            top: 2px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--accent-gold);
        }

        .timeline-date {
            font-size: 0.8rem;
            color: var(--accent-gold);
            font-weight: bold;
        }

        .timeline-title {
            font-size: 0.95rem;
            color: #fff;
            margin: 2px 0 4px 0;
            font-weight: 600;
        }

        .timeline-desc {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.4;
        }

        .award-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(212, 175, 55, 0.2);
            border-radius: 10px;
            padding: 12px 15px;
            margin-bottom: 12px;
            text-align: left;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .award-icon {
            font-size: 1.8rem;
        }

        .lightbox-modal {
            display: none;
            position: fixed;
            z-index: 9999999;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.92);
            backdrop-filter: blur(8px);
            justify-content: center;
            align-items: center;
        }

        .lightbox-modal.active { display: flex !important; }

        .lightbox-img {
            max-width: 95%;
            max-height: 85vh;
            border-radius: 12px;
            border: 2px solid var(--accent-gold);
            object-fit: contain;
        }

        footer {
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-secondary);
            margin-top: 10px;
        }
    </style>
</head>
<body>

<!-- 📌 SAĞ ÜSTTE SABİT MENÜ İKONLARI -->
<nav class="sticky-nav">
    <div class="nav-btn" onclick="openModal('cvModal')" data-tooltip="Öz Geçmiş">📜</div>
    <div class="nav-btn" onclick="openModal('locationsModal')" data-tooltip="Görev Yerleri">📍</div>
    <div class="nav-btn" onclick="openModal('awardsModal')" data-tooltip="Takdirler">🎖️</div>
</nav>

<div class="container">

    <!-- KART 1: BAŞLIK, TARİH VE BÜYÜK FOTOĞRAF -->
    <div class="card">
        <div class="top-header">
            <div class="company-badge">TÜRK SİLAHLI KUVVETLERİ</div>
            <div class="current-date-badge" id="currentDateBadge">--.--.----</div>
        </div>

        <h1>Mehmet YILMAZ</h1>
        <div class="subtitle">Kıdemli Bando Astsubay</div>
        
        <div class="retirement-date-box">
            Emeklilik Tarihi: <strong>01.08.2026</strong>
        </div>
        
        <div class="hero-banner">
            <img src="ekip_buyuk.jpg" alt="Tüm Ekip Hatıra Fotoğrafı" class="zoomable-img">
            <div class="hero-caption">Silah Arkadaşlarıyla Geçen Onurlu Yılların Anısına 🔍</div>
        </div>
    </div>
    <!-- KART 2: VEDA VİDEOSU -->
    <div class="card">
        <h3 class="section-title">Anı Videosu</h3>
        <div class="media-container">
            <video controls poster="video_kapak.jpg">
                <source src="veda_videosu.mp4" type="video/mp4">
                Tarayıcınız video etiketini desteklemiyor.
            </video>
        </div>
    </div>

    <!-- KART 3: FOTOĞRAF GALERİSİ -->
    <div class="card">
        <h3 class="section-title">Hizmet Anıları</h3>
        <div class="photo-gallery">
            <div class="photo-card"><img src="foto1.jpg" alt="Anı 1" class="zoomable-img"><div class="photo-desc">Tören Anı</div></div>
            <div class="photo-card"><img src="foto2.jpg" alt="Anı 2" class="zoomable-img"><div class="photo-desc">Görev Saati</div></div>
            <div class="photo-card"><img src="foto3.jpg" alt="Anı 3" class="zoomable-img"><div class="photo-desc">Tatbikat</div></div>
            <div class="photo-card"><img src="foto4.jpg" alt="Anı 4" class="zoomable-img"><div class="photo-desc">Silah Arkadaşları</div></div>
            <div class="photo-card"><img src="foto5.jpg" alt="Anı 5" class="zoomable-img"><div class="photo-desc">Saha Görevi</div></div>
            <div class="photo-card"><img src="foto6.jpg" alt="Anı 6" class="zoomable-img"><div class="photo-desc">Veda Yemeği</div></div>
        </div>
    </div>

    <!-- KART 4: TEŞEKKÜR MESAJI -->
    <div class="card">
        <h3 class="section-title">Sonsuz Teşekkürlerimizle</h3>
        <p class="message-text">
            "Vatan hizmetinde geçen uzun yıllar boyunca sergilediğiniz üstün disiplin, tecrübe ve arkadaşlık ruhu için şükranlarımızı sunarız. Birlikte paylaştığımız zorluklar ve kazanılan başarılar daima gururla hatırlanacaktır. Emeklilik hayatınızda sevdiklerinizle birlikte sağlık, huzur ve mutluluk dileriz."
        </p>
    </div>
    <!-- KART 5: EMEKLİLİK SAYACI -->
    <div class="card retirement-counter">
        <div style="color: var(--accent-gold); font-size: 0.9rem;">Emekliliğin Tadını Çıkarıyorsun</div>
        <div class="counter-number" id="daysCounter">0</div>
        <div style="font-size: 0.85rem; color: var(--text-secondary);">GÜNDÜR EMEKLİSİN</div>
    </div>

    <!-- KART 6: EMEĞİ GEÇENLER LİSTESİ -->
    <div class="card">
        <h3 class="section-title" style="margin-bottom: 8px;">Emeği Geçen Silah Arkadaşları</h3>
        <div class="contributors-grid">
            <div class="contributor-item">Ali KAYA</div>
            <div class="contributor-item">Ahmet DEMİR</div>
            <div class="contributor-item">Hasan ÖZTÜRK</div>
            <div class="contributor-item">Hüseyin ARSLAN</div>
            <div class="contributor-item">Mustafa AYDIN</div>
            <div class="contributor-item">Emre KOÇ</div>
            <div class="contributor-item">Burak ŞAHİN</div>
            <div class="contributor-item">Murat YILDIZ</div>
            <div class="contributor-item">Ömer ERDOĞAN</div>
            <div class="contributor-item">İbrahim ŞEN</div>
        </div>
    </div>

    <footer>
        Tüm Silah Arkadaşlarından Sevgilerle ❤️
    </footer>

</div>
<!-- 📌 MODAL 1: ÖZ GEÇMİŞ -->
<div id="cvModal" class="modal">
    <div class="modal-content">
        <span class="close-btn" onclick="closeModal('cvModal')">&times;</span>
        <h2>📜 Öz Geçmiş</h2>
        <div class="modal-body">
            <p><strong>1998 - 2002:</strong> Bando Astsubay Hazırlama Okulu ve Sınıf Okulu Eğitimi</p>
            <p><strong>2002:</strong> İlk kıta görevine başlangıç.</p>
            <p><strong>2002 - 2026:</strong> Türk Silahlı Kuvvetleri bünyesinde Türkiye'nin çeşitli garnizonlarında Bando Astsubay olarak şerefle yürütülen görev süresi.</p>
            <p><strong>01.08.2026:</strong> Kıdemli Bando Astsubay rütbesiyle kadrosuzluk/hizmet süresi tamamlanarak emeklilik.</p>
        </div>
    </div>
</div>

<!-- 📌 MODAL 2: GÖREV YERLERİ -->
<div id="locationsModal" class="modal">
    <div class="modal-content">
        <span class="close-btn" onclick="closeModal('locationsModal')">&times;</span>
        <h2>📍 Görev Yapılan Yerler</h2>
        <div class="modal-body">
            <ul>
                <li>Ankara - Mzk.K.lığı (2002 - 2007)</li>
                <li>Erzurum - 9. Kor.K.lığı (2007 - 2012)</li>
                <li>İzmir - Ege Ordu K.lığı (2012 - 2018)</li>
                <li>Kıbrıs - KTKBK (2018 - 2021)</li>
                <li>İstanbul - 1. Ordu K.lığı (2021 - 2026)</li>
            </ul>
        </div>
    </div>
</div>

<!-- 📌 MODAL 3: TAKDİRLER VE ÖDÜLLER -->
<div id="awardsModal" class="modal">
    <div class="modal-content">
        <span class="close-btn" onclick="closeModal('awardsModal')">&times;</span>
        <h2>🎖️ Takdir ve Ödüller</h2>
        <div class="modal-body">
            <ul>
                <li>Üstün Hizmet ve Başarı Belgesi (3 Adet)</li>
                <li>Şerit Rozet ve Övünç Madalyası</li>
                <li>Tugay ve Ordu Komutanlığı Takdirnameleri</li>
                <li>20 Yıl Hizmet Sadakat Madalyası</li>
            </ul>
        </div>
    </div>
</div>

<!-- 🔍 FOTOĞRAF BÜYÜTME (LIGHTBOX) OVERLAY -->
<div id="imageLightbox" class="lightbox" onclick="closeLightbox()">
    <span class="lightbox-close">&times;</span>
    <img id="lightboxImg" src="" alt="Büyütülmüş Fotoğraf">
</div>
<script>
    // 📅 1. BUGÜNÜN TARİHİNİ ROZETE YAZDIRMA
    function setTodayDate() {
        const today = new Date();
        const day = String(today.getDate()).padStart(2, '0');
        const month = String(today.getMonth() + 1).padStart(2, '0');
        const year = today.getFullYear();
        document.getElementById('currentDateBadge').innerText = `${day}.${month}.${year}`;
    }

    // ⏳ 2. EMEKLİLİK GÜN SAYACINI HESAPLAMA
    function updateRetirementCounter() {
        const retirementDate = new Date("2026-08-01T00:00:00");
        const today = new Date();
        
        // Zaman farkını gün olarak hesapla
        const diffTime = today - retirementDate;
        let diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
        
        // Henüz emeklilik tarihi gelmediyse 0 göster
        if (diffDays < 0) {
            diffDays = 0;
        }
        
        document.getElementById('daysCounter').innerText = diffDays;
    }

    // 🚪 3. MODAL (POP-UP) AÇMA / KAPATMA FONKSİYONLARI
    function openModal(modalId) {
        document.getElementById(modalId).style.display = "flex";
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = "none";
    }

    // Modal dışına tıklayınca kapatma
    window.onclick = function(event) {
        if (event.target.classList.contains('modal')) {
            event.target.style.display = "none";
        }
    }

    // 🔍 4. FOTOĞRAF BÜYÜTME (LIGHTBOX)
    document.querySelectorAll('.zoomable-img').forEach(img => {
        img.addEventListener('click', function() {
            const lightbox = document.getElementById('imageLightbox');
            const lightboxImg = document.getElementById('lightboxImg');
            lightboxImg.src = this.src;
            lightbox.style.display = 'flex';
        });
    });

    function closeLightbox() {
        document.getElementById('imageLightbox').style.display = 'none';
    }

    // SAYFA YÜKLENDİĞİNDE HESAPLAMALARI ÇALIŞTIR
    window.onload = function() {
        setTodayDate();
        updateRetirementCounter();
    };
</script>

</body>
</html>
